# --- Supabase ---
# Get these from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# Supabase renamed this in late 2024: "anon" key → "publishable" key.
# Set EITHER of the two below (whichever name the dashboard shows for you):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only needed for server-side admin operations (none yet in Phase 1).
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used for magic-link callback. Must match Supabase Auth "Site URL".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI providers (set via Settings UI in Phase 1.5; these are optional fallbacks for dev) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=http://localhost:4096
